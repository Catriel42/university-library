# Server Configuration
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/university_library?schema=public

# Authentication
JWT_SECRET="your-secret-change-in-production"

# CORS
FRONTEND_URL="http://localhost:5173"

# Optional: Open Library API contact email (for User-Agent header)
OPENLIBRARY_CONTACT_EMAIL=contact@example.com

# Optional: Loan configuration
# DEFAULT_COPIES=3
# LOAN_PERIOD_DAYS=14
# MAX_ACTIVE_LOANS=5
# HOLD_WINDOW_HOURS=48
