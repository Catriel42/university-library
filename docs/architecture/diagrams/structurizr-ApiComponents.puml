database "==PostgreSQL Database\n<size:10>[Container: PostgreSQL 16]</size>\n\nStores users, loans, reservations, holds, reading status, and work copy counts." <<UniversityLibrarySPA.PostgreSQLDatabase>> as UniversityLibrarySPA.PostgreSQLDatabase
database "==In-Process LRU Cache\n<size:10>[Container: lru-cache (Node.js)]</size>\n\nServer-side in-memory cache for Open Library API responses. TTL: 10 min search, 24 h work details. No external cache required." <<UniversityLibrarySPA.InProcessLRUCache>> as UniversityLibrarySPA.InProcessLRUCache

rectangle "Express REST API\n<size:10>[Container: Node.js + Express + TypeScript]</size>" <<UniversityLibrarySPA.ExpressRESTAPI>> {
  rectangle "==Auth Controller\n<size:10>[Component: Express Router]</size>\n\nHandles register, login, logout, and /me endpoints. Issues and validates JWTs via HttpOnly cookies." <<UniversityLibrarySPA.ExpressRESTAPI.AuthController>> as UniversityLibrarySPA.ExpressRESTAPI.AuthController
  rectangle "==Book Controller\n<size:10>[Component: Express Router]</size>\n\nProxies search and work-detail requests to Open Library, merges live availability data." <<UniversityLibrarySPA.ExpressRESTAPI.BookController>> as UniversityLibrarySPA.ExpressRESTAPI.BookController
  rectangle "==Loan Controller\n<size:10>[Component: Express Router]</size>\n\nHandles borrow, return, renew, and loan history endpoints." <<UniversityLibrarySPA.ExpressRESTAPI.LoanController>> as UniversityLibrarySPA.ExpressRESTAPI.LoanController
  rectangle "==Reservation Controller\n<size:10>[Component: Express Router]</size>\n\nHandles reserve, cancel, and my-reservations endpoints. Manages FIFO queue and hold conversion." <<UniversityLibrarySPA.ExpressRESTAPI.ReservationController>> as UniversityLibrarySPA.ExpressRESTAPI.ReservationController
  rectangle "==Reading Status Controller\n<size:10>[Component: Express Router]</size>\n\nHandles set, clear, and my-books endpoints for per-user reading status tracking." <<UniversityLibrarySPA.ExpressRESTAPI.ReadingStatusController>> as UniversityLibrarySPA.ExpressRESTAPI.ReadingStatusController
  rectangle "==Auth Service\n<size:10>[Component: TypeScript service]</size>\n\nRegistration, login with bcrypt password hashing, and JWT token signing." <<UniversityLibrarySPA.ExpressRESTAPI.AuthService>> as UniversityLibrarySPA.ExpressRESTAPI.AuthService
  rectangle "==Book Service\n<size:10>[Component: TypeScript service]</size>\n\nBatched availability query (ADR-0002). Merges Open Library results with local copy counts." <<UniversityLibrarySPA.ExpressRESTAPI.BookService>> as UniversityLibrarySPA.ExpressRESTAPI.BookService
  rectangle "==Loan Service\n<size:10>[Component: TypeScript service]</size>\n\nTransactional borrow/return/renew logic. Enforces BR-01 to BR-09. Triggers hold conversion on return." <<UniversityLibrarySPA.ExpressRESTAPI.LoanService>> as UniversityLibrarySPA.ExpressRESTAPI.LoanService
  rectangle "==Reservation Service\n<size:10>[Component: TypeScript service]</size>\n\nFIFO queue management. Hold creation (BR-11). Expired-hold release evaluated at read/write time (BR-12)." <<UniversityLibrarySPA.ExpressRESTAPI.ReservationService>> as UniversityLibrarySPA.ExpressRESTAPI.ReservationService
  rectangle "==Reading Status Service\n<size:10>[Component: TypeScript service]</size>\n\nUpsert and delete reading status per (user, work). Enforces one status per pair (NFR-15)." <<UniversityLibrarySPA.ExpressRESTAPI.ReadingStatusService>> as UniversityLibrarySPA.ExpressRESTAPI.ReadingStatusService
  rectangle "==Open Library Service\n<size:10>[Component: TypeScript service + lru-cache]</size>\n\nHTTP client for Open Library. LRU cache: 10 min for search, 24 h for work details (ADR-0003). Zod response validation." <<UniversityLibrarySPA.ExpressRESTAPI.OpenLibraryService>> as UniversityLibrarySPA.ExpressRESTAPI.OpenLibraryService
  rectangle "==Auth Middleware\n<size:10>[Component: Express middleware]</size>\n\nValidates JWT from HttpOnly cookie on protected routes. Returns HTTP 401 on failure." <<UniversityLibrarySPA.ExpressRESTAPI.AuthMiddleware>> as UniversityLibrarySPA.ExpressRESTAPI.AuthMiddleware
  rectangle "==Prisma Client\n<size:10>[Component: Prisma 7]</size>\n\nType-safe ORM. All DB access goes through this layer." <<UniversityLibrarySPA.ExpressRESTAPI.PrismaClient>> as UniversityLibrarySPA.ExpressRESTAPI.PrismaClient
}

