@startuml
set separator none
title University Library SPA - Containers

top to bottom direction
skinparam ranksep 60
skinparam nodesep 30

skinparam {
  arrowFontSize 10
  defaultTextAlignment center
  wrapWidth 200
  maxMessageSize 100
}

hide stereotype

skinparam rectangle<<UniversityLibrarySPA.ExpressRESTAPI>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
  shadowing false
}
skinparam database<<UniversityLibrarySPA.InProcessLRUCache>> {
  BackgroundColor #dc382d
  FontColor #ffffff
  BorderColor #9a271f
  shadowing false
}
skinparam rectangle<<OpenLibrary>> {
  BackgroundColor #6b7280
  FontColor #ffffff
  BorderColor #4a4f59
  shadowing false
}
skinparam database<<UniversityLibrarySPA.PostgreSQLDatabase>> {
  BackgroundColor #336791
  FontColor #ffffff
  BorderColor #234865
  shadowing false
}
skinparam rectangle<<UniversityLibrarySPA.ReactSPA>> {
  BackgroundColor #438dd5
  FontColor #ffffff
  BorderColor #2e6295
  shadowing false
}
skinparam person<<RegisteredUser>> {
  BackgroundColor #0d7377
  FontColor #ffffff
  BorderColor #095053
  shadowing false
}
skinparam person<<Visitor>> {
  BackgroundColor #0d7377
  FontColor #ffffff
  BorderColor #095053
  shadowing false
}
skinparam rectangle<<UniversityLibrarySPA>> {
  BorderColor #0b4884
  FontColor #0b4884
  shadowing false
}

person "==Registered User\n<size:10>[Person]</size>\n\nA student or faculty member. Can borrow, reserve, renew, return books, and track reading status." <<RegisteredUser>> as RegisteredUser
person "==Visitor\n<size:10>[Person]</size>\n\nAn unauthenticated person. Can browse and search the catalog but cannot borrow or reserve." <<Visitor>> as Visitor
rectangle "==Open Library\n<size:10>[Software System]</size>\n\nPublic book catalog API by the Internet Archive. Provides bibliographic metadata, cover images, and search." <<OpenLibrary>> as OpenLibrary

rectangle "University Library SPA\n<size:10>[Software System]</size>" <<UniversityLibrarySPA>> {
  rectangle "==React SPA\n<size:10>[Container: React 19 + TypeScript (Vite)]</size>\n\nClient-side single-page application. Handles routing, state management, and all user interactions." <<UniversityLibrarySPA.ReactSPA>> as UniversityLibrarySPA.ReactSPA
  rectangle "==Express REST API\n<size:10>[Container: Node.js + Express + TypeScript]</size>\n\nServes the frontend, enforces all business rules (loans, reservations, holds), proxies and caches Open Library, and manages authentication." <<UniversityLibrarySPA.ExpressRESTAPI>> as UniversityLibrarySPA.ExpressRESTAPI
  database "==PostgreSQL Database\n<size:10>[Container: PostgreSQL 16]</size>\n\nStores users, loans, reservations, holds, reading status, and work copy counts." <<UniversityLibrarySPA.PostgreSQLDatabase>> as UniversityLibrarySPA.PostgreSQLDatabase
  database "==In-Process LRU Cache\n<size:10>[Container: lru-cache (Node.js)]</size>\n\nServer-side in-memory cache for Open Library API responses. TTL: 10 min search, 24 h work details. No external cache required." <<UniversityLibrarySPA.InProcessLRUCache>> as UniversityLibrarySPA.InProcessLRUCache
}

RegisteredUser -[#707070,thickness=2]-> UniversityLibrarySPA.ReactSPA : "<color:#707070>Interacts with\n<color:#707070><size:8>[HTTPS]</size>"
Visitor -[#707070,thickness=2]-> UniversityLibrarySPA.ReactSPA : "<color:#707070>Browses catalog via\n<color:#707070><size:8>[HTTPS]</size>"
UniversityLibrarySPA.ReactSPA -[#707070,thickness=2]-> UniversityLibrarySPA.ExpressRESTAPI : "<color:#707070>Calls REST API\n<color:#707070><size:8>[HTTPS / JSON]</size>"
UniversityLibrarySPA.ExpressRESTAPI -[#707070,thickness=2]-> UniversityLibrarySPA.PostgreSQLDatabase : "<color:#707070>Reads and writes all library state\n<color:#707070><size:8>[TCP / Prisma ORM]</size>"
UniversityLibrarySPA.ExpressRESTAPI -[#707070,thickness=2]-> UniversityLibrarySPA.InProcessLRUCache : "<color:#707070>Reads and writes cached OL responses\n<color:#707070><size:8>[In-process]</size>"
UniversityLibrarySPA.InProcessLRUCache -[#707070,thickness=2]-> OpenLibrary : "<color:#707070>Fetches on cache miss\n<color:#707070><size:8>[HTTPS / REST]</size>"
@enduml