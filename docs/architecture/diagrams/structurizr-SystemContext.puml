@startuml
set separator none
title University Library SPA - System Context

top to bottom direction
skinparam ranksep 60
skinparam nodesep 30

skinparam {
  arrowFontSize 10
  defaultTextAlignment center
  wrapWidth 200
  maxMessageSize 100
}

hide stereotype

skinparam rectangle<<OpenLibrary>> {
  BackgroundColor #6b7280
  FontColor #ffffff
  BorderColor #4a4f59
  shadowing false
}
skinparam person<<RegisteredUser>> {
  BackgroundColor #0d7377
  FontColor #ffffff
  BorderColor #095053
  shadowing false
}
skinparam rectangle<<UniversityLibrarySPA>> {
  BackgroundColor #1168bd
  FontColor #ffffff
  BorderColor #0b4884
  shadowing false
}
skinparam person<<Visitor>> {
  BackgroundColor #0d7377
  FontColor #ffffff
  BorderColor #095053
  shadowing false
}

person "==Registered User\n<size:10>[Person]</size>\n\nA student or faculty member. Can borrow, reserve, renew, return books, and track reading status." <<RegisteredUser>> as RegisteredUser
person "==Visitor\n<size:10>[Person]</size>\n\nAn unauthenticated person. Can browse and search the catalog but cannot borrow or reserve." <<Visitor>> as Visitor
rectangle "==Open Library\n<size:10>[Software System]</size>\n\nPublic book catalog API by the Internet Archive. Provides bibliographic metadata, cover images, and search." <<OpenLibrary>> as OpenLibrary
rectangle "==University Library SPA\n<size:10>[Software System]</size>\n\nSingle-Page Application that allows users to browse the catalog, borrow and reserve books, and track their reading status." <<UniversityLibrarySPA>> as UniversityLibrarySPA

RegisteredUser -[#707070,thickness=2]-> UniversityLibrarySPA : "<color:#707070>Browses catalog, borrows and reserves books, tracks reading status\n<color:#707070><size:8>[HTTPS]</size>"
Visitor -[#707070,thickness=2]-> UniversityLibrarySPA : "<color:#707070>Browses and searches the catalog\n<color:#707070><size:8>[HTTPS]</size>"
UniversityLibrarySPA -[#707070,thickness=2]-> OpenLibrary : "<color:#707070>Fetches bibliographic metadata and cover images\n<color:#707070><size:8>[HTTPS / REST]</size>"
@enduml