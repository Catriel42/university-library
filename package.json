{
  "name": "university-library-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm --filter @university-library/frontend dev",
    "dev:backend": "pnpm --filter @university-library/backend dev",
    "build:frontend": "pnpm --filter @university-library/frontend build",
    "build:backend": "pnpm --filter @university-library/backend build",
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @university-library/shared exec tsc --noEmit && pnpm --filter @university-library/backend exec tsc --noEmit && pnpm --filter @university-library/frontend exec tsc -b --noEmit",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/engines",
      "@prisma/client",
      "workerd"
    ]
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
